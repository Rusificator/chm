#include <iostream>
#include <fstream>
#include <cmath>
using namespace std;

int main()
{
    setlocale(LC_ALL, "Rus");
    
    ifstream fin;
    ofstream fout;
  
    int n;
    fin.open("input.txt");
    if (!fin)
    { 
        cout<<"Не удалось открыть input.txt\n"; 
        return 1; 
    }
    fout.open("output.txt");
    if (!fout) 
    { 
        cout<<"Не удалось открыть output.txt\n";
        return 1;
    }

    fin >> n;
    double** a = new double* [n];
    for (int i = 0; i < n; i++) 
        a[i] = new double[n + 1];

        
    for (int i = 0; i < n; i++)
        for (int j = 0; j <= n; j++)
            fin >> a[i][j];
   

    //прямой ход
    bool f = false;
    for (int k = 0; k < n; k++) {
        //поиск главного элемента по столбцу
        int p = k;
        double maxAbs = fabs(a[k][k]);
        for (int i = k + 1; i < n; i++) 
        {
            if (fabs(a[i][k]) > maxAbs) 
            {
                maxAbs = fabs(a[i][k]);
                p = i;
            }
        }

        if (maxAbs < 1e-12) 
        { 
            f = true; 
            break; 
        }

        //перестановка строк
        if (p != k) {
            double* tmp = a[k];
            a[k] = a[p];
            a[p] = tmp;
        }

        //исключение x_k из строк ниже
        for (int i = k + 1; i < n; i++) 
        {
            double m = a[i][k] / a[k][k];
            for (int j = k; j <= n; j++)
                a[i][j] -= m * a[k][j];
        }
    }

    //
    if (f) 
    {
        fout<<"Система не имеет единственного решения.\n";
        cout<<"Система не имеет единственного решения.\n";
    }
    else 
    {
        //обратный ход
        double* x = new double[n];
        for (int i = n - 1; i >= 0; i--) 
        {
            double sum = 0.0;
            for (int j = i + 1; j < n; j++)
                sum += a[i][j] * x[j];
            x[i] = (a[i][n] - sum) / a[i][i];
        }

        
    fout<<"Решение системы:\n";
    for (int i = 0; i < n; i++)
        fout<<"x"<<i+1<<"="<<x[i]<<"\n";
        
      

        delete[] x;
    }

    //очищаем память/закрываем файлы
    for (int i = 0; i < n; i++) 
        delete[] a[i];
    delete[] a;

     fin.close();
     fout.close(); 
     return 0;
}
